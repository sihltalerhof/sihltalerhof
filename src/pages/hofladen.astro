---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import ScheduledText from '../components/ScheduledText.astro';
import { getCollection, getEntry, render } from 'astro:content';

const page = await getEntry('pages', 'hofladen');
if (!page) throw new Error('pages/hofladen.md fehlt');
const { Content } = await render(page);

const noticeEntries = await Promise.all(
  (await getCollection('notices'))
    .filter((n) => n.data.page === 'hofladen')
    .map(async (n) => ({ entry: n, Content: (await render(n)).Content }))
);
---
<Layout title={page.data.title}>
  <PageHead title={page.data.title} />

  <div class="section">
    {noticeEntries.map(({ entry, Content: NoticeContent }) => (
      <ScheduledText from={entry.data.from} until={entry.data.until}>
        <div class="notice">
          <strong>{entry.data.title}</strong>
          <NoticeContent />
        </div>
      </ScheduledText>
    ))}

    <Content />

    <div class="gallery">
      <img
        src="/images/site/hofladen-1.jpg"
        alt="Der Sihltalerhofladen weihnachtlich beleuchtet im Schnee"
        loading="lazy"
      />
      <img
        src="/images/site/hofladen-2.jpg"
        alt="Regal im Hofladen mit Honig, Geschenkartikeln und Holzschnitzereien"
        loading="lazy"
      />
      <img
        src="/images/site/hofladen-3.jpg"
        alt="Kühlschrank mit Trockenwürsten im Hofladen"
        loading="lazy"
      />
      <img
        src="/images/site/hofladen-4.jpg"
        alt="Tiefkühltruhe mit verpacktem Bio-Rindfleisch"
        loading="lazy"
      />
    </div>
  </div>
</Layout>
