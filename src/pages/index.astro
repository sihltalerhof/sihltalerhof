---
import Layout from '../layouts/Layout.astro';
import { getEntry, render } from 'astro:content';

const page = await getEntry('pages', 'home');
if (!page) throw new Error('pages/home.md fehlt');
const { Content } = await render(page);
---
<Layout title={page.data.title}>
  <div class="hero">
    <img src="/images/site/hero-hof.jpg" alt="Sihltalerhof" />
  </div>

  <Content />

  <div class="certifications">
    <img src="/images/site/bio-suisse-logo.jpg" alt="Bio Suisse" />
    <img src="/images/site/mutterkuh-logo.jpg" alt="Mutterkuh Schweiz" />
    <img src="/images/site/kagfreiland-logo.jpg" alt="Kagfreiland" />
  </div>
</Layout>
