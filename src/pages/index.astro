---
import Layout from '../layouts/Layout.astro';
import { getEntry, render } from 'astro:content';

const page = await getEntry('pages', 'home');
if (!page) throw new Error('pages/home.md fehlt');
const { Content } = await render(page);
---
<Layout title={page.data.title}>
  <div class="hero-wrap">
    <div class="hero-photo">
      <img
        src="/images/site/hero-hof.jpg"
        alt="Der Sihltalerhof mit Weideland im Sihltal"
        width="2560"
        height="1920"
      />
    </div>
    <div class="hero-banner">
      <p>Kühe würden den Sihltalerhof wählen</p>
    </div>
  </div>

  <div class="section">
    <Content />

    <div class="certifications">
      <div class="cert-seal">
        <img src="/images/site/bio-suisse-logo.jpg" alt="Bio Suisse" loading="lazy" />
      </div>
      <div class="cert-seal">
        <img src="/images/site/mutterkuh-logo.jpg" alt="Mutterkuh Schweiz" loading="lazy" />
      </div>
      <div class="cert-seal">
        <img src="/images/site/kagfreiland-logo.jpg" alt="Kagfreiland" loading="lazy" />
      </div>
    </div>
  </div>
</Layout>
