---
import Layout from '../layouts/Layout.astro';
import PageHead from '../components/PageHead.astro';
import ScheduledText from '../components/ScheduledText.astro';
import { getCollection, getEntry, render } from 'astro:content';

const page = await getEntry('pages', 'ueber-uns');
if (!page) throw new Error('pages/ueber-uns.md fehlt');
const { Content } = await render(page);

const noticeEntries = await Promise.all(
  (await getCollection('notices'))
    .filter((n) => n.data.page === 'ueber-uns')
    .map(async (n) => ({ entry: n, Content: (await render(n)).Content }))
);
---
<Layout title={page.data.title}>
  <PageHead title={page.data.title} />

  <div class="section">
    {noticeEntries.map(({ entry, Content: NoticeContent }) => (
      <ScheduledText from={entry.data.from} until={entry.data.until}>
        <div class="notice">
          <strong>{entry.data.title}</strong>
          <NoticeContent />
        </div>
      </ScheduledText>
    ))}

    <img
      class="framed-photo framed-photo--portrait"
      src="/images/site/familie.jpg"
      alt="Familie Fässler-Günthard"
      width="1920"
      height="2560"
      loading="lazy"
    />

    <Content />
  </div>
</Layout>
